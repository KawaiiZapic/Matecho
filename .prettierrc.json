{
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "printWidth": 80,
  "semi": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "htmlWhitespaceSensitivity": "ignore",
  "endOfLine": "lf",
  "plugins": ["@prettier/plugin-php"],
  "phpVersion": "7.4",
  "braceStyle": "1tbs",
  "trailingCommaPHP": false
}
