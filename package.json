    "browserslist-useragent-regexp": "^4.1.3",
    "clipboard": "^2.0.11",
    "core-js": "^3.47.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fast-glob": "^3.3.3",
    "http-proxy": "^1.18.1",
    "katex": "^0.16.27",
    "less": "^4.5.1",
