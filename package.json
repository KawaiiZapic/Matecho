{
  "type": "module",
  "web-types": [
    "./node_modules/mdui/web-types.zh-cn.json"
  ],
  "dependencies": {
    "@fancyapps/ui": "^6.1.13",
    "@mdui/icons": "^1.0.3",
    "@mermaid-js/mermaid-zenuml": "^0.2.2",
    "@prettier/plugin-oxc": "^0.1.4",
    "@prettier/plugin-php": "^0.25.0",
    "@types/http-proxy": "^1.17.17",
    "@types/jquery": "^3.5.30",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.0.3",
    "@types/nprogress": "^0.2.3",
    "@types/prismjs": "^1.26.6",
    "@unocss/core": "^66.6.8",
    "@unocss/eslint-plugin": "^66.6.8",
    "autoprefixer": "^10.5.0",
    "browserslist-useragent-regexp": "^4.1.4",
    "clipboard": "^2.0.11",
    "core-js": "^3.49.0",
    "fast-glob": "^3.3.3",
    "http-proxy": "^1.18.1",
    "katex": "^0.16.45",
    "less": "^4.6.4",
    "lint-staged": "^16.4.0",
    "mdui": "^2.1.4",
    "mermaid": "^11.14.0",
    "nprogress": "^0.2.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.1",
    "pjax": "^0.2.8",
    "postcss": "^8.5.10",
    "postcss-gap-properties": "^7.0.0",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.3",
    "prismjs": "^1.30.0",
    "shiki": "^4.0.2",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-less": "^4.1.0",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "vite": "^8.0.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "simple-git-hooks",
    "type-check": "tsc --noEmit",
    "format": "prettier -w -u --cache --log-level error .",
    "lint": "oxlint --max-warnings 0 . && stylelint --max-warnings 0 **/*.{c,le}ss",
    "lint:fix": "oxlint --max-warnings 0 --fix . && stylelint --max-warnings 0 --fix **/*.{c,le}ss && oxfmt"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --fix --max-warnings 0",
      "prettier -w --cache"
    ],
    "*.{c,le}ss": [
      "stylelint --fix --max-warnings 0",
      "prettier -w --cache"
    ],
    "!(*.{css,less,js,ts})": [
      "prettier -w -u --cache"
    ]
  },
  "version": "0.5.2"
}
